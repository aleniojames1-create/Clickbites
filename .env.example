NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
FRONTEND_PORT=5173
FRONTEND_PORT_MAX=5199
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
JWT_SECRET=replace-with-a-long-random-secret
DB_FILE=./data/clickbites.db
UPLOAD_DIR=./uploads
COOKIE_SECURE=false
PASSWORD_RESET_MINUTES=15
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin1234!
PLATFORM_COMMISSION_PERCENT=5

# Gmail / SMTP OTP delivery
# For Gmail, create a Google App Password (2-Step Verification required).
# Do NOT put your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=yourgmail@gmail.com
# Development only: if Gmail SMTP is misconfigured, keep registration testable by printing the OTP in the server CMD. Set false to fail instead.
EMAIL_DEV_FALLBACK=true

# Twilio SMS OTP (optional; required for production SMS delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# PayMongo Checkout (optional until merchant is activated)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_BASE_URL=https://api.paymongo.com
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVEMODE=false
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

# Maya Checkout (optional until sandbox keys are provisioned)
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
