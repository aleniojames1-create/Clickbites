{
  "name": "clickbites-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "ClickBites local food marketplace with Express, SQLite and a preserved static frontend.",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "vite",
    "start": "node server/server.js",
    "build": "node scripts/build-check.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "check": "node scripts/check-project.mjs",
    "test": "node --test tests/*.test.mjs",
    "server": "node server/server.js",
    "dev:frontend": "vite",
    "server:backend": "node server/server.js",
    "dev:backend": "node --watch server/server.js",
    "doctor": "node scripts/doctor.mjs",
    "dev:legacy": "node scripts/frontend-dev.mjs",
    "setup": "node scripts/setup-windows.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  }
}
